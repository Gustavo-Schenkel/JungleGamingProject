# Copie este arquivo para .env (nunca envie seu .env ao Git).
# O aplicativo Go utiliza variaveis de ambiente do PROCESSO; veja scripts/start-stage4.ps1.
APP_ADDR=127.0.0.1:8080
APP_ENV=development
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=jungle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SET_YOUR_LOCAL_PASSWORD
POSTGRES_SSLMODE=disable
POSTGRES_COMPOSE_PORT=5433
LOCALSTACK_PORT=4566
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# Etapa 6: validacao OIDC obrigatoria, sem bypass mesmo em desenvolvimento.
OIDC_ISSUER=http://localhost:8081/realms/jungle
OIDC_AUDIENCE=jungle-api
OIDC_PROVIDER_CLIENTS=jungle-provider-alpha:provider-alpha,jungle-provider-beta:provider-beta
OIDC_INTERNAL_CLIENT=jungle-internal
# O script setup-keycloak.ps1 gera e adiciona ao .env local as variaveis
# KEYCLOAK_PROVIDER_ALPHA_SECRET, KEYCLOAK_PROVIDER_BETA_SECRET e KEYCLOAK_INTERNAL_SECRET.

# Etapa 7: execute scripts/setup-sqs.ps1 depois de copiar o .env da Etapa 6.
# Credenciais de assinatura sao geradas localmente (nao compartilhe o .env).
SQS_ENABLED=true
SQS_ENDPOINT=http://127.0.0.1:4566
AWS_REGION=us-east-1
SQS_INCOMING_QUEUE=jungle-commands.fifo
SQS_OUTGOING_QUEUE=jungle-events.fifo
SQS_DLQ=jungle-commands-dlq.fifo
SQS_COMMAND_KEYS=GENERATED_BY_SETUP_SCRIPT
